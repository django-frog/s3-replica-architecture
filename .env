APP_ENV=development
# Format as a strict JSON array so Pydantic can parse it natively
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000","http://localhost"]

# API -> MinIO Connection
MINIO_ENDPOINT=vault.local:9000
MINIO_ACCESS_KEY=root_admin
MINIO_SECRET_KEY=secure_password_123
MINIO_BUCKET_NAME=secure-vault
URL_EXPIRATION=60

KEYCLOAK_URL=http://idp.vault.local:8080
KEYCLOAK_REALM=secure-vault-realm

KEYCLOAK_FRONTEND_URL=http://localhost:8080

# Infrastructure Root Credentials (Consumed by Docker Compose)
INFRA_KEYCLOAK_ADMIN=admin
INFRA_KEYCLOAK_PASSWORD=super_secret_idp_password
