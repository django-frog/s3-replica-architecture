APP_ENV=development

# CORS Origins (Comma-separated string or JSON array supported by updated config.py)
BACKEND_CORS_ORIGINS=["*"]
# API -> MinIO Connection
# Replaced 'vault.local:9000' with the Docker Compose service name 'minio:9000'
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=root_admin
MINIO_SECRET_KEY=secure_password_123
MINIO_BUCKET_NAME=secure-vault
URL_EXPIRATION=60

# API -> Keycloak Connection
# Replaced 'http://idp.vault.local:8080' with the Docker Compose service name 'http://keycloak:8080'
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=secure-vault-realm
KEYCLOAK_FRONTEND_URL=http://localhost:8080

# Infrastructure Root Credentials (Consumed by Docker Compose for Keycloak admin setup)
INFRA_KEYCLOAK_ADMIN=admin
INFRA_KEYCLOAK_PASSWORD=super_secret_idp_password
